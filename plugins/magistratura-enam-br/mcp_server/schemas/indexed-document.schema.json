{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/junior-aguiar-eng/magistratura-enam-br/schemas/mcp/indexed-document-v1.json",
  "title": "Documento Markdown indexado v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "relative_path", "size_bytes", "modified_at", "sha256", "title", "chunks"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_id": {"type": "string", "pattern": "^doc_[0-9a-f]{16,64}$"},
    "relative_path": {
      "type": "string",
      "minLength": 3,
      "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+\\.md$"
    },
    "size_bytes": {"type": "integer", "minimum": 0},
    "modified_at": {"type": "string", "format": "date-time"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 500},
    "chunks": {
      "type": "array",
      "items": {"$ref": "#/$defs/chunk"}
    }
  },
  "$defs": {
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_id", "heading", "ordinal", "text"],
      "properties": {
        "chunk_id": {"type": "string", "pattern": "^chk_[0-9a-f]{16,64}$"},
        "heading": {"type": ["string", "null"], "maxLength": 500},
        "ordinal": {"type": "integer", "minimum": 0},
        "text": {"type": "string", "minLength": 1}
      }
    }
  }
}

