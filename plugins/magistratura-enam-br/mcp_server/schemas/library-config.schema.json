{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/junior-aguiar-eng/magistratura-enam-br/schemas/mcp/library-config-v1.json",
  "title": "Configuração da biblioteca Markdown v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "library_root", "write_consent", "excluded_directories", "limits"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "library_root": {
      "type": "string",
      "minLength": 3,
      "pattern": "^(?:[A-Za-z]:\\\\|\\\\\\\\).+"
    },
    "write_consent": {"const": true},
    "excluded_directories": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {"pattern": "[\\\\/]"}
      },
      "allOf": [
        {"contains": {"const": ".git"}},
        {"contains": {"const": ".estudo-juridico"}},
        {"contains": {"const": "node_modules"}}
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_file_bytes", "max_result_chunks"],
      "properties": {
        "max_file_bytes": {"type": "integer", "minimum": 1024, "maximum": 20000000},
        "max_result_chunks": {"type": "integer", "minimum": 1, "maximum": 50}
      }
    }
  }
}

