{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Comparativo temático ENAM",
  "type": "object", "additionalProperties": false,
  "required": ["escopo", "itens"],
  "properties": {
    "escopo": {"type": "string", "minLength": 1},
    "itens": {"type": "array", "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "referencia": {"type": "object", "additionalProperties": false, "required": ["documento", "pagina", "localizacao"], "properties": {"documento": {"type": "string", "minLength": 1}, "pagina": {"type": "string", "minLength": 1}, "localizacao": {"type": "string", "minLength": 1}}},
    "item": {"type": "object", "additionalProperties": false, "required": ["disciplina", "tema_subtema", "referencias_anteriores", "referencias_atuais", "tipo_correspondencia", "classificacao", "delta_real", "evidencias"], "properties": {"disciplina": {"type": "string", "minLength": 1}, "tema_subtema": {"type": "string", "minLength": 1}, "referencias_anteriores": {"type": "array", "items": {"$ref": "#/$defs/referencia"}}, "referencias_atuais": {"type": "array", "items": {"$ref": "#/$defs/referencia"}}, "tipo_correspondencia": {"type": "string", "minLength": 1}, "classificacao": {"enum": ["ATUALIZACAO LEGISLATIVA", "ATUALIZACAO JURISPRUDENCIAL", "ALTERACAO DOUTRINARIA MATERIAL", "CORRECAO DE CONTEUDO", "INCLUSAO MATERIAL", "EXCLUSAO MATERIAL CONFIRMADA", "SUPRESSAO APARENTE - REVISAO HUMANA", "SEM DELTA", "PENDENTE DE PUBLICACAO", "AMBIGUO - REVISAO HUMANA"]}, "delta_real": {"type": "string", "minLength": 1}, "evidencias": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/referencia"}}, "observacao": {"type": "string"}}}
  }
}
