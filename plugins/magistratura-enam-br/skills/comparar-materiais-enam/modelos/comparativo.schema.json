{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Comparativo temático ENAM",
  "type": "object",
  "additionalProperties": false,
  "required": ["id_execucao", "escopo", "itens"],
  "properties": {
    "id_execucao": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "escopo": {"type": "string", "minLength": 1},
    "itens": {"type": "array", "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "referencia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documento", "pagina", "localizacao"],
      "properties": {
        "documento": {"type": "string", "minLength": 1},
        "pagina": {"type": "string", "minLength": 1},
        "localizacao": {"type": "string", "minLength": 1}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id_item", "disciplina", "tema_subtema", "referencias_anteriores", "referencias_atuais", "tipo_correspondencia", "classificacao", "delta_real", "acao_recomendada", "evidencias"],
      "properties": {
        "id_item": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "disciplina": {"type": "string", "minLength": 1},
        "tema_subtema": {"type": "string", "minLength": 1},
        "referencias_anteriores": {"type": "array", "items": {"$ref": "#/$defs/referencia"}},
        "referencias_atuais": {"type": "array", "items": {"$ref": "#/$defs/referencia"}},
        "tipo_correspondencia": {"enum": ["CORRESPONDENCIA EDITORIAL EXPRESSA", "DESLOCAMENTO EDITORIAL EXPRESSO", "CORRESPONDENCIA TEMATICA CONFIRMADA", "CORRESPONDENCIA PARCIAL", "CORRESPONDENCIA TEMATICA PROVAVEL", "CORRESPONDENCIA NAO CONFIRMADA"]},
        "classificacao": {"enum": ["ATUALIZACAO LEGISLATIVA", "ATUALIZACAO JURISPRUDENCIAL", "ALTERACAO DOUTRINARIA MATERIAL", "CORRECAO DE CONTEUDO", "INCLUSAO MATERIAL", "EXCLUSAO MATERIAL CONFIRMADA", "SUPRESSAO APARENTE - REVISAO HUMANA", "SEM DELTA", "PENDENTE DE PUBLICACAO", "AMBIGUO - REVISAO HUMANA"]},
        "delta_real": {"type": "string", "minLength": 1},
        "acao_recomendada": {"enum": ["INCLUIR", "SUBSTITUIR", "REVISAR", "AGUARDAR_PUBLICACAO", "SEM_ACAO"]},
        "fundamento_material": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tipo", "identificador", "fonte_oficial"],
          "properties": {
            "tipo": {"enum": ["LEGISLACAO", "JURISPRUDENCIA"]},
            "identificador": {"type": "string", "minLength": 1},
            "fonte_oficial": {"type": "string", "minLength": 1}
          }
        },
        "evidencias": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/referencia"}},
        "observacao": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"classificacao": {"const": "ATUALIZACAO LEGISLATIVA"}}},
          "then": {
            "required": ["fundamento_material"],
            "properties": {"fundamento_material": {"properties": {"tipo": {"const": "LEGISLACAO"}}}}
          }
        },
        {
          "if": {"properties": {"classificacao": {"const": "ATUALIZACAO JURISPRUDENCIAL"}}},
          "then": {
            "required": ["fundamento_material"],
            "properties": {"fundamento_material": {"properties": {"tipo": {"const": "JURISPRUDENCIA"}}}}
          }
        }
      ]
    }
  }
}
