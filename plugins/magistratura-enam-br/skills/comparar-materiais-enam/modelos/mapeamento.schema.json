{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mapeamento temático ENAM",
  "type": "object", "additionalProperties": false,
  "required": ["escopo", "itens"],
  "properties": {
    "escopo": {"type": "string", "minLength": 1},
    "itens": {"type": "array", "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "referencia": {"type": "object", "additionalProperties": false, "required": ["documento", "pagina", "localizacao"], "properties": {"documento": {"type": "string", "minLength": 1}, "pagina": {"type": "string", "minLength": 1}, "localizacao": {"type": "string", "minLength": 1}}},
    "item": {"type": "object", "additionalProperties": false, "required": ["disciplina", "tema_subtema", "referencias_anteriores", "referencias_atuais", "tipo_correspondencia", "evidencias"], "properties": {"disciplina": {"type": "string", "minLength": 1}, "tema_subtema": {"type": "string", "minLength": 1}, "referencias_anteriores": {"type": "array", "items": {"$ref": "#/$defs/referencia"}}, "referencias_atuais": {"type": "array", "items": {"$ref": "#/$defs/referencia"}}, "tipo_correspondencia": {"enum": ["CORRESPONDENCIA EDITORIAL EXPRESSA", "DESLOCAMENTO EDITORIAL EXPRESSO", "CORRESPONDENCIA TEMATICA CONFIRMADA", "CORRESPONDENCIA PARCIAL", "CORRESPONDENCIA TEMATICA PROVAVEL", "CORRESPONDENCIA NAO CONFIRMADA"]}, "evidencias": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/referencia"}}, "base_editorial": {"type": "string", "minLength": 1}, "observacao": {"type": "string"}}}
  }
}
