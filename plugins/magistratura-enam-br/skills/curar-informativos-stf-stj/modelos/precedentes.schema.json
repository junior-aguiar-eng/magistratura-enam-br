{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "precedentes.schema.json",
  "$defs": {
    "content_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "disciplina", "tema", "subtema", "source_refs", "source_state"],
      "properties": {
        "kind": {"const": "precedente"},
        "id": {"type": "string", "minLength": 1},
        "disciplina": {"type": "string", "minLength": 1},
        "tema": {"type": "string", "minLength": 1},
        "subtema": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source_state": {"type": "string", "minLength": 1}
      }
    }
  },
  "title": "Registros de precedentes",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["processo", "tribunal", "estado_jurisprudencial", "grau_confianca"],
    "properties": {
      "id_decisao": {"type": "string", "minLength": 1},
      "processo": {"type": "string", "minLength": 1},
      "tema": {"type": "string"},
      "tribunal": {"enum": ["STF", "STJ"]},
      "orgao_julgador": {"type": "string"},
      "disciplina": {"type": "string"},
      "estado_jurisprudencial": {"enum": ["confirmado", "confirmado com ressalvas", "restringido ou distinguido", "superado", "controvertido", "não verificado"]},
      "grau_confianca": {"enum": ["alto", "médio", "baixo"]},
      "nota_estado": {"type": "string"},
      "data_julgamento": {"type": "string", "format": "date"},
      "data_informativo": {"type": "string", "format": "date"},
      "tese_resumida": {"type": "string"},
      "fontes_essenciais": {"type": "array", "items": {"type": "string", "minLength": 1}},
      "content_ref": {"$ref": "#/$defs/content_ref"}
    },
    "allOf": [
      {
        "if": {"properties": {"estado_jurisprudencial": {"not": {"const": "confirmado"}}}},
        "then": {"required": ["nota_estado"]}
      }
    ]
  }
}
