{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Registro interno de estudo de julgado",
  "description": "Modelo opcional para continuidade do estudo; não é conteúdo a ser exibido ao usuário.",
  "type": "object",
  "additionalProperties": false,
  "required": ["processo", "tribunal", "tema", "situacao_estudo"],
  "properties": {
    "processo": {"type": "string", "minLength": 1},
    "tribunal": {"enum": ["STF", "STJ", "OUTRO"]},
    "tema": {"type": "string", "minLength": 1},
    "disciplina": {"type": "string"},
    "tese_resumida": {"type": "string"},
    "situacao_estudo": {"enum": ["selecionado", "em_estudo", "em_revisao", "consolidado"]},
    "prioridade": {"enum": ["alta", "regular"]},
    "erro_documentado": {"type": "boolean"},
    "proxima_revisao": {"type": "string", "format": "date"},
    "observacao": {"type": "string"}
  }
}
