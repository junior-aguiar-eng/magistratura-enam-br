{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/junior-aguiar-eng/magistratura-enam-br/schemas/pedagogia/trusted-source-registry-v1.json",
  "title": "Trusted legal source registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "sources"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tier", "canonical_domains", "allowed_purposes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
        "name": {"type": "string", "minLength": 1},
        "tier": {"enum": ["primaria", "secundaria"]},
        "canonical_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"}
        },
        "allowed_purposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["legislacao", "jurisprudencia", "andamento_processual", "informativo", "noticia_institucional", "analise_editorial", "doutrina", "localizacao_fontes"]}
        },
        "authoritative_for": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["legislacao", "jurisprudencia", "andamento_processual", "informativo"]}
        },
        "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {"if": {"properties": {"tier": {"const": "primaria"}}}, "then": {"required": ["authoritative_for"]}},
        {"if": {"properties": {"tier": {"const": "secundaria"}}}, "then": {"required": ["limitations"]}}
      ]
    }
  }
}
