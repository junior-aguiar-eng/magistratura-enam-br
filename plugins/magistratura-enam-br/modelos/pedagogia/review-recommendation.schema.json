{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/junior-aguiar-eng/magistratura-enam-br/schemas/pedagogia/review-recommendation-v1.json",
  "title": "Review recommendation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy", "base_interval_days", "suggested_interval_days", "reason_codes", "shadow_mode"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy": {"enum": ["fixed_v1", "adaptive_v1"]},
    "base_interval_days": {"type": "integer", "minimum": 1, "maximum": 90},
    "suggested_interval_days": {"type": "integer", "minimum": 1, "maximum": 90},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["fixed_policy_preserved", "incorrect", "partial", "low_confidence", "missing_justification", "high_confidence_no_transfer", "high_confidence_with_transfer", "repeated_error"]}
    },
    "shadow_mode": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"policy": {"const": "fixed_v1"}}},
      "then": {"properties": {"suggested_interval_days": {"const": 7}, "shadow_mode": {"const": true}}}
    }
  ]
}
