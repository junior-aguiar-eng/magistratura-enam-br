{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/junior-aguiar-eng/magistratura-enam-br/schemas/pedagogia/learning-event-v1.json",
  "title": "Learning event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "occurred_at", "skill", "content_ref", "activity", "performance", "routing"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"type": "string", "pattern": "^evt_[0-9a-z-]{20,64}$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "skill": {
      "enum": [
        "comparar-materiais-enam",
        "curar-informativos-stf-stj",
        "estudar-direito-magistratura",
        "planejar-jurisprudencia"
      ]
    },
    "content_ref": {"$ref": "#/$defs/content_ref"},
    "activity": {"$ref": "#/$defs/activity"},
    "performance": {"$ref": "#/$defs/performance"},
    "routing": {"$ref": "#/$defs/routing"}
  },
  "$defs": {
    "content_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_id", "source_type"],
      "properties": {
        "content_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"},
        "source_type": {
          "enum": ["material_candidato", "mapa_curricular", "analise_estrategica", "fonte_oficial", "complemento_geral", "material_publicado"]
        },
        "locator": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modality", "attempt_observed"],
      "properties": {
        "modality": {
          "enum": ["explicacao", "recuperacao", "consolidacao", "vespera", "questao_objetiva", "discursiva_curta", "prova_oral", "leitura_julgado", "revisao_julgado"]
        },
        "attempt_observed": {"type": "boolean"}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "error_types", "domain_evidence", "confidence"],
      "properties": {
        "result": {"enum": ["nao_avaliado", "correto", "parcial", "incorreto", "questao_invalida"]},
        "error_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["conceito", "pressuposto", "regra", "excecao", "competencia", "legitimidade", "prazo", "efeito", "suporte_fatico", "distincao", "atualizacao_normativa", "atualizacao_jurisprudencial", "fundamentacao", "expressao_oral", "estrutura_discursiva"]}
        },
        "domain_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["evocacao_regra", "discriminacao_institutos", "aplicacao_fatos_novos", "fundamentacao_normativa_jurisprudencial", "expressao_objetiva_discursiva_oral", "retencao_revisao_posterior"]}
        },
        "confidence": {"enum": [null, "baixa", "media", "alta"]}
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_skill", "reason_codes"],
      "properties": {
        "target_skill": {
          "enum": [null, "comparar-materiais-enam", "curar-informativos-stf-stj", "estudar-direito-magistratura", "planejar-jurisprudencia"]
        },
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"activity": {"properties": {"attempt_observed": {"const": false}}}}},
      "then": {"properties": {"performance": {"properties": {"result": {"const": "nao_avaliado"}, "error_types": {"maxItems": 0}, "domain_evidence": {"maxItems": 0}, "confidence": {"const": null}}}}}
    },
    {
      "if": {"properties": {"skill": {"const": "comparar-materiais-enam"}}},
      "then": {
        "properties": {
          "activity": {"properties": {"attempt_observed": {"const": false}}},
          "performance": {"properties": {"result": {"const": "nao_avaliado"}, "error_types": {"maxItems": 0}, "domain_evidence": {"maxItems": 0}, "confidence": {"const": null}}}
        }
      }
    }
  ]
}
