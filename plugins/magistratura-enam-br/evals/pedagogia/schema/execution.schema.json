{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "case_snapshot", "case_sha256", "output", "output_sha256", "evaluation"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "case_snapshot": {"type": "object"},
    "case_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "output": {"type": "string", "pattern": "\\S"},
    "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluation": {"type": "object"},
    "human_review": {"$ref": "#/$defs/review"}
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "executed_at", "plugin_version", "model", "client", "session_id", "round", "origin"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,120}$"},
        "executed_at": {"type": "string", "format": "date-time"},
        "plugin_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "model": {"$ref": "#/$defs/text"}, "client": {"$ref": "#/$defs/text"},
        "session_id": {"$ref": "#/$defs/text"},
        "round": {"type": "integer", "minimum": 1},
        "origin": {"enum": ["captured_session", "synthetic_fixture"]},
        "duration_seconds": {"type": "number", "minimum": 0},
        "tokens": {"type": "integer", "minimum": 0}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer", "reviewed_at", "review_note", "output_sha256", "case_sha256", "criteria"],
      "properties": {
        "reviewer": {"$ref": "#/$defs/text"},
        "reviewed_at": {"type": "string", "format": "date"},
        "review_note": {"$ref": "#/$defs/text"},
        "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "case_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "criteria": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "passed", "evidence"],
            "properties": {"id": {"$ref": "#/$defs/text"}, "passed": {"type": "boolean"}, "evidence": {"$ref": "#/$defs/text"}}
          }
        }
      }
    }
  }
}
