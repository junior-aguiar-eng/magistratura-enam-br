{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magistratura-enam-br.local/schemas/evals-pedagogicos-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline", "target", "evals"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "baseline": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "target": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "evals": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/eval"}
    }
  },
  "$defs": {
    "legalClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expected_conclusion", "official_source", "locator", "supports"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "expected_conclusion": {"type": "string", "minLength": 1},
        "official_source": {"type": "string", "pattern": "^src_[a-z0-9-]+$"},
        "locator": {"type": "string", "minLength": 1},
        "supports": {"type": "string", "minLength": 1}
      }
    },
    "legalGrounding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked_at", "cutoff_date", "claims", "human_review"],
      "properties": {
        "checked_at": {"type": "string", "format": "date"},
        "cutoff_date": {"type": "string", "format": "date"},
        "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/legalClaim"}},
        "human_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["review_status", "review_note"],
          "properties": {
            "review_status": {"enum": ["pending", "approved", "rejected"]},
            "review_note": {"type": "string"}
          },
          "if": {"properties": {"review_status": {"const": "approved"}}},
          "then": {"properties": {"review_note": {"minLength": 1, "pattern": "\\S"}}}
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "description": {"type": "string", "minLength": 1},
        "kind": {"enum": ["automatic", "human"]},
        "check": {
          "enum": ["contains_all", "forbidden_terms", "option_count", "ends_after_option_e", "ordered_markers"]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "expected": {"type": "integer", "minimum": 0}
      }
    },
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "skill", "prompt", "fixtures", "expected_output", "assertions", "human_rubric", "risk_tags"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "front": {
          "enum": ["orquestracao", "dogmatica", "caso_complexo", "objetiva", "discursiva", "oral", "revisao", "curadoria", "planejamento", "comparacao", "perfil_local"]
        },
        "skill": {
          "enum": [
            "estudar-direito-magistratura",
            "curar-informativos-stf-stj",
            "planejar-jurisprudencia",
            "comparar-materiais-enam",
            "acompanhar-percurso-magistratura",
            "treinador-fgv-magistratura"
          ]
        },
        "prompt": {"type": "string", "minLength": 20},
        "turns": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "expected_route": {
          "enum": [
            "estudar-direito-magistratura",
            "curar-informativos-stf-stj",
            "planejar-jurisprudencia",
            "comparar-materiais-enam",
            "acompanhar-percurso-magistratura"
          ]
        },
        "expected_external_skill": {"const": "treinador-fgv-magistratura"},
        "expected_transition": {
          "enum": ["ambientacao_inicial", "continuidade_direta", "mudanca_com_pendencia", "mudanca_sem_pendencia", "preservar_rota", "bloqueio_por_insumo"]
        },
        "source_policy": {
          "enum": ["nao_aplicavel", "acervo_exclusivo", "acervo_com_atualizacao_oficial", "pesquisa_completa", "hierarquia_oficial"]
        },
        "follow_ups": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "fixtures": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "expected_output": {"type": "string", "minLength": 1},
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/assertion"}
        },
        "semantic_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description", "evidence_required"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
              "description": {"type": "string", "minLength": 1},
              "evidence_required": {"type": "string", "minLength": 1}
            }
          }
        },
        "legal_grounding": {"$ref": "#/$defs/legalGrounding"},
        "human_rubric": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "risk_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"skill": {"const": "treinador-fgv-magistratura"}}, "required": ["skill"]},
          "then": {"required": ["expected_external_skill"], "not": {"required": ["expected_route"]}},
          "else": {"not": {"required": ["expected_external_skill"]}}
        }
      ]
    }
  }
}
